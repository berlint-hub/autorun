+namespace FEX::Windows::HorizonHeap {
+NTSTATUS Call(unsigned Function, void* Args);
+struct alignas(16) Header {
+  void* Base;
+  size_t Size;
+};
+
+inline void* Allocate(size_t Size, size_t Alignment = 16, ULONG Flags = 0) {
+  if (!Alignment || (Alignment & (Alignment - 1))) {
+    errno = EINVAL;
+    return nullptr;
+  }
+  if (Alignment < alignof(Header)) Alignment = alignof(Header);
+  const size_t Padding = Alignment - alignof(Header);
+  if (Size > SIZE_MAX - sizeof(Header) - Padding) {
+    errno = ENOMEM;
+    return nullptr;
+  }
+  wine_nx_fex_heap Args {Size + sizeof(Header) + Padding, 0, (Flags & HEAP_ZERO_MEMORY) ? 1U : 0U};
+  if (Call(WINE_NX_FEX_HEAP_ALLOC, &Args)) {
+    errno = ENOMEM;
+    return nullptr;
+  }
+  void* Base = reinterpret_cast<void*>(Args.pointer);
+  const auto Address = (reinterpret_cast<uintptr_t>(Base) + sizeof(Header) + Alignment - 1) & ~(Alignment - 1);
+  auto* Data = reinterpret_cast<Header*>(Address) - 1;
+  Data->Base = Base;
+  Data->Size = Size;
+  return Data + 1;
+}
+
+inline void Free(void* Pointer) {
+  if (!Pointer) return;
+  wine_nx_fex_heap Args {0, reinterpret_cast<uintptr_t>((static_cast<Header*>(Pointer) - 1)->Base), 0};
+  Call(WINE_NX_FEX_HEAP_FREE, &Args);
+}
+
+inline size_t Size(void* Pointer) {
+  return Pointer ? (static_cast<Header*>(Pointer) - 1)->Size : 0;
+}
+
+inline void* Calloc(size_t Count, size_t Size) {
+  if (Size && Count > SIZE_MAX / Size) {
+    errno = ENOMEM;
+    return nullptr;
+  }
+  return Allocate(Count * Size, 16, HEAP_ZERO_MEMORY);
+}
 
