+inline void* Reallocate(void* Pointer, size_t NewSize) {
+  if (!Pointer) return Allocate(NewSize);
+  if (!NewSize) {
+    Free(Pointer);
+    return nullptr;
+  }
+  if (NewSize > SIZE_MAX - sizeof(Header)) {
+    errno = ENOMEM;
+    return nullptr;
+  }
+  auto* Data = static_cast<Header*>(Pointer) - 1;
+  if (Data->Base == Data) {
+    wine_nx_fex_heap Args {NewSize + sizeof(Header), reinterpret_cast<uintptr_t>(Data), 0};
+    if (Call(WINE_NX_FEX_HEAP_REALLOC, &Args)) {
+      errno = ENOMEM;
+      return nullptr;
+    }
+    auto* NewData = reinterpret_cast<Header*>(Args.pointer);
+    NewData->Base = NewData;
+    NewData->Size = NewSize;
+    return NewData + 1;
+  }
+  void* Result = Allocate(NewSize);
+  if (Result) {
+    std::memcpy(Result, Pointer, NewSize < Data->Size ? NewSize : Data->Size);
