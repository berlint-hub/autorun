From: Autorun <noreply@autorun.local>
Subject: [PATCH] Fix the FEX-2610 Horizon port's compile errors

Horizon.h defines HorizonWritableAddress and HorizonFlushICache inline
while Source/Windows/Common/CRT/HorizonHeap.cpp defines the same two
functions and includes the header: a redefinition in every CRT
translation unit. Autorun's horizon.patch keeps Horizon.h to
declarations and leaves the definitions with the CRT; this restores
that split. And CPUFeatures.cpp clears HostFeatures.SupportsAVX256,
which FEX-2610 no longer has (SupportsAVX is the flag, and the port
already clears it). FEX-2610 (berlint-hub/FEX @ arena/799d045b-fex).
---
 FEXCore/include/FEXCore/Utils/Horizon.h | 17 ++++++-----------
 Source/Windows/Common/CPUFeatures.cpp   | 1 -
 2 files changed, 5 insertions(+), 12 deletions(-)

diff --git a/FEXCore/include/FEXCore/Utils/Horizon.h b/FEXCore/include/FEXCore/Utils/Horizon.h
--- a/FEXCore/include/FEXCore/Utils/Horizon.h
+++ b/FEXCore/include/FEXCore/Utils/Horizon.h
@@ -10,17 +10,11 @@
 namespace FEXCore {
 namespace Allocator {
 
-/* Writable address mapping for Horizon code buffers */
-inline void* HorizonWritableAddress(void* Pointer) {
-    return Pointer;  // Direct mapping for fallback; overridden when FEX_HORIZON is active
-}
-
-/* Flush instruction cache after code emission */
-inline void HorizonFlushICache(void* Begin, std::size_t Length) {
-#if defined(__linux__) || defined(__unix__)
-    __builtin___clear_cache(static_cast<char*>(Begin), static_cast<char*>(Begin) + Length);
-#endif
-}
+/* Writable address mapping for Horizon code buffers, and the instruction
+   cache flush after code emission: defined once by the Horizon CRT in
+   Source/Windows/Common/CRT/HorizonHeap.cpp, like Autorun's horizon.patch. */
+void* HorizonWritableAddress(void* Pointer);
+void HorizonFlushICache(void* Begin, std::size_t Length);
 
 } // namespace Allocator
 } // namespace FEXCore
diff --git a/Source/Windows/Common/CPUFeatures.cpp b/Source/Windows/Common/CPUFeatures.cpp
--- a/Source/Windows/Common/CPUFeatures.cpp
+++ b/Source/Windows/Common/CPUFeatures.cpp
@@ -90,7 +90,6 @@
   HostFeatures.SupportsAtomics = false;
   HostFeatures.SupportsSVE128 = false;
   HostFeatures.SupportsSVE256 = false;
-  HostFeatures.SupportsAVX256 = false;
   HostFeatures.SupportsRPRES = false;
   HostFeatures.SupportsAFP = false;
 
