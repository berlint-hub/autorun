+   void (*hook)(void *data) = horizon_pending_hook;
+   void *hook_data = horizon_pending_hook_data;
 
+   horizon_pending_hook = NULL;
    if (!hctx || !surf->att[ST_ATTACHMENT_BACK_LEFT])
       return EGL_FALSE;
 
@@ -388,6 +422,8 @@ horizon_swap_buffers(_EGLDisplay *disp, _EGLSurface *base)
       return _eglError(EGL_BAD_SURFACE, "eglSwapBuffers");
    }
    surf->swap_st = st;
