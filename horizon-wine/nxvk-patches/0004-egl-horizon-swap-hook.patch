@@ -76,8 +76,29 @@ struct horizon_egl_surface {
    struct util_queue_fence swapped;
    struct st_context *swap_st;
    bool swap_failed;
+   /* What the swap draws into the back buffer first (horizon_egl_next_swap_hook). */
+   void (*swap_hook)(void *data);
+   void *swap_hook_data;
