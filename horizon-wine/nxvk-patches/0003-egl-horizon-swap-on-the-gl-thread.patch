@@ -69,6 +70,12 @@ struct horizon_egl_surface {
    struct pipe_resource *att[ST_ATTACHMENT_COUNT];
    NWindow *win;
    bool is_window;
+   /* With glthread the GL thread does the swap (horizon_swap_buffers):
+    * signalled once it has, with the context it did it for and whether the
+    * swapchain went out of date meanwhile. */
+   struct util_queue_fence swapped;
+   struct st_context *swap_st;
+   bool swap_failed;
 };
 
 static struct horizon_egl_surface *
@@ -197,6 +204,7 @@ horizon_create_surface(_EGLDisplay *disp, EGLint type, _EGLConfig *conf,
 
    surf->pscreen = hdpy->pscreen;
    surf->is_window = type == EGL_WINDOW_BIT;
+   util_queue_fence_init(&surf->swapped);
 
    if (surf->is_window) {
       surf->win = native_window ? native_window : nwindowGetDefault();
@@ -285,6 +293,9 @@ horizon_destroy_surface(_EGLDisplay *disp, _EGLSurface *base)
       struct horizon_egl_surface *surf = horizon_egl_surface(base);
 
       horizon_glthread_finish(st_api_get_current());
+      /* A swap the GL thread of a context no longer current has yet to do. */
+      util_queue_fence_wait(&surf->swapped);
+      util_queue_fence_destroy(&surf->swapped);
 
       for (unsigned i = 0; i < ST_ATTACHMENT_COUNT; i++)
          pipe_resource_reference(&surf->att[i], NULL);
@@ -310,22 +321,18 @@ horizon_before_flush_cb(void *args)
    a->pipe->flush_resource(a->pipe, a->back);
 }
 
-static EGLBoolean
-horizon_swap_buffers(_EGLDisplay *disp, _EGLSurface *base)
+/* The swap itself, on the thread the pipe context is used from: the caller's
+ * with glthread off, the GL thread with it on. False when the swapchain went
+ * out of date.
+ */
+static bool
+horizon_present(struct horizon_egl_surface *surf, struct st_context *st)
 {
-   struct horizon_egl_display *hdpy = horizon_egl_display(disp);
-   struct horizon_egl_surface *surf = horizon_egl_surface(base);
-   struct horizon_egl_context *hctx =
-      horizon_egl_context(base->CurrentContext);
    struct pipe_resource *back = surf->att[ST_ATTACHMENT_BACK_LEFT];
-
-   if (!hctx || !back)
-      return EGL_FALSE;
-
-   struct st_context *st = hctx->st;
    struct horizon_flush_args args = { st->pipe, back };
 
-   horizon_glthread_finish(st);
+   if (!back)
+      return false;
 
    /* flush_resource has to land after the pending GL work is submitted but
     * before the pipe flush.
@@ -333,17 +340,63 @@ horizon_swap_buffers(_EGLDisplay *disp, _EGLSurface *base)
    st_context_flush(st, ST_FLUSH_END_OF_FRAME, NULL,
                     horizon_before_flush_cb, &args);
 
-   hdpy->pscreen->flush_frontbuffer(hdpy->pscreen, st->pipe, back, 0, 0,
+   surf->pscreen->flush_frontbuffer(surf->pscreen, st->pipe, back, 0, 0,
                                     &surf->drawable, 0, NULL);
 
    /* The swapchain rotates the VkImage behind this resource. The resource
     * itself is persistent. A failed check means it went out of date. */
    if (surf->is_window && !zink_kopper_check(back))
-      return _eglError(EGL_BAD_SURFACE, "eglSwapBuffers");
+      return false;
 
    p_atomic_inc(&surf->drawable.stamp);
    st_context_invalidate_state(st, ST_INVALIDATE_FB_STATE);
+   return true;
+}
 
+static void
+horizon_present_on_glthread(struct gl_context *ctx, void *data)
+{
+   struct horizon_egl_surface *surf = data;
+
+   if (!horizon_present(surf, surf->swap_st))
+      surf->swap_failed = true;
+   util_queue_fence_signal(&surf->swapped);
+}
+
+static EGLBoolean
+horizon_swap_buffers(_EGLDisplay *disp, _EGLSurface *base)
+{
+   struct horizon_egl_surface *surf = horizon_egl_surface(base);
+   struct horizon_egl_context *hctx =
+      horizon_egl_context(base->CurrentContext);
+
+   if (!hctx || !surf->att[ST_ATTACHMENT_BACK_LEFT])
+      return EGL_FALSE;
+
+   struct st_context *st = hctx->st;
+
+   /* With glthread on, the GL thread swaps once it has run the frame's last
+    * commands, and this thread goes on with the next frame instead of
+    * waiting for it to: the frame's GL work and the next one's game work
+    * overlap. This thread waits only for the swap before, so the GL thread
+    * is never more than a frame behind. A swapchain that went out of date
+    * is said at the next swap.
+    */
+   util_queue_fence_wait(&surf->swapped);
+   if (surf->swap_failed) {
+      surf->swap_failed = false;
+      return _eglError(EGL_BAD_SURFACE, "eglSwapBuffers");
+   }
+   surf->swap_st = st;
+   util_queue_fence_reset(&surf->swapped);
+   if (_mesa_glthread_flush_and_call(st->ctx, horizon_present_on_glthread,
+                                     surf))
+      return EGL_TRUE;
+   util_queue_fence_signal(&surf->swapped);
+
+   horizon_glthread_finish(st);
+   if (!horizon_present(surf, st))
+      return _eglError(EGL_BAD_SURFACE, "eglSwapBuffers");
    return EGL_TRUE;
 }
 
diff --git a/src/mesa/main/glthread.c b/src/mesa/main/glthread.c
index bbde478..4431ce7 100644
--- a/src/mesa/main/glthread.c
+++ b/src/mesa/main/glthread.c
@@ -151,6 +151,13 @@ glthread_unmarshal_batch(void *job, void *gdata, int thread_index)
    assert(pos == used);
    batch->used = 0;
 
+   if (batch->after) {
+      void (*after)(struct gl_context *, void *) = batch->after;
+
+      batch->after = NULL;
+      after(ctx, batch->after_data);
+   }
+
    unsigned batch_index = batch - ctx->GLThread.batches;
    _mesa_glthread_signal_call(&ctx->GLThread.LastProgramChangeBatch, batch_index);
    _mesa_glthread_signal_call(&ctx->GLThread.LastDListChangeBatchIndex, batch_index);
@@ -380,6 +387,30 @@ _mesa_glthread_flush_batch(struct gl_context *ctx)
    glthread->next_batch = &glthread->batches[glthread->next];
 }
 
+/**
+ * Submits what was given so far and has the GL thread call func(ctx, data)
+ * after it, without waiting: _mesa_glthread_finish then also waits for the
+ * call. False, and nothing called, when glthread is off, the batch is empty
+ * or this is the GL thread: the caller does the work itself.
+ */
+bool
+_mesa_glthread_flush_and_call(struct gl_context *ctx,
+                              void (*func)(struct gl_context *ctx, void *data),
+                              void *data)
+{
+   struct glthread_state *glthread = &ctx->GLThread;
+
+   if (!glthread->enabled || !glthread->used ||
+       ctx->Dispatch.Current == ctx->Dispatch.ContextLost ||
+       u_thread_is_self(glthread->queue.threads[0]))
+      return false;
+
+   glthread->next_batch->after = func;
+   glthread->next_batch->after_data = data;
+   _mesa_glthread_flush_batch(ctx);
+   return true;
+}
+
 /**
  * Waits for all pending batches have been unmarshaled.
  *
