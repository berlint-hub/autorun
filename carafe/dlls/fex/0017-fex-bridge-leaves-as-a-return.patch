Carafe: with BridgeReturn, the WoW64 system-call and unix-call bridge leaves as a return. The guest reaches the bridge
through a call, and the bridge goes on at the return address that call left on the stack, so the call-return stack
kept the call's entry: every later return of the outer frames then popped the entry of the frame below it and missed.
On FEX-2611 every system call leaves its block for the dispatcher's system-call handler, which looks the next RIP up
itself; for a 32-bit WoW64 guest the handler now first looks at the top of the call-return stack and, when it holds
the return address, pops it and returns to its host code; otherwise it leaves the stack alone and takes the lookup as
before. Off by default.
MIT, as the files it changes.

diff --git a/FEXCore/Source/Interface/Config/Config.json.in b/FEXCore/Source/Interface/Config/Config.json.in
--- a/FEXCore/Source/Interface/Config/Config.json.in
+++ b/FEXCore/Source/Interface/Config/Config.json.in
@@ -710,6 +710,16 @@
           "jumps, inserts carry bits with fewer instructions and drops dead NZCV inserts and carry inversions."
         ]
       },
+      "BridgeReturn": {
+        "Type": "bool",
+        "Default": "false",
+        "AffectsCodeGen": "true",
+        "Desc": [
+          "The WoW64 system-call and unix-call bridge, entered by a call and left to the return address, leaves as a",
+          "return: when the top of the call-return stack holds that address it is popped and returned to, so the",
+          "stack stays in step with the guest's calls."
+        ]
+      },
       "IndirectCallCache": {
         "Type": "bool",
         "Default": "false",
diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -607,6 +607,21 @@ void Dispatcher::EmitDispatcher() {
       // Most syscall instructions just return to the following RIP, so it is highly likely to be in the L1 in tight loops.
       ldr(TMP3, STATE_PTR(CpuStateFrame, State.rip));
 
+      // The WoW64 system-call and unix-call bridge (int 0x2e) is entered by a call and goes on at the return address that
+      // call left: when the top of the call-return stack holds it, it is popped and returned to, so the stack stays in
+      // step with the guest's calls.
+      FEX_CONFIG_OPT(BridgeReturn, BRIDGERETURN);
+      if (BridgeReturn() && !CTX->Config.Is64BitMode &&
+          CTX->HostFeatures.ProcessFeatures.HostType == FEXCore::HostFeatures::HostTypeEnum::Wow64) {
+        ARMEmitter::ForwardLabel NotOnTop;
+        ldp<ARMEmitter::IndexType::OFFSET>(TMP1, TMP2, REG_CALLRET_SP, 0);
+        sub(TMP1, TMP1, TMP3);
+        (void)cbnz(ARMEmitter::Size::i64Bit, TMP1, &NotOnTop);
+        add(ARMEmitter::Size::i64Bit, REG_CALLRET_SP, REG_CALLRET_SP, 0x10);
+        ret(TMP2);
+        (void)Bind(&NotOnTop);
+      }
+
       // Calculate (tmp1 + (((ripreg ^ (ripreg >> 4)) & L1_ENTRIES_MASK) << 4)) for the address
       // L1Mask is pre-shifted.
       eor(ARMEmitter::Size::i64Bit, TMP1, TMP3, TMP3, ARMEmitter::ShiftType::LSL, FEXCore::ilog2(sizeof(LookupCache::LookupCacheEntry)));
