+  static uint32_t PayloadCrc(std::span<const std::span<const uint8_t>> Chunks) {
+    XXH3_state_t State;
+    XXH3_64bits_reset(&State);
+    for (const std::span<const uint8_t>& Chunk : Chunks) {
+      XXH3_64bits_update(&State, Chunk.data(), Chunk.size());
+    }
+    const uint32_t Crc = (uint32_t)XXH3_64bits_digest(&State);
+    return Crc ? Crc : 1;
+  }
+
+  // On Horizon there is no writer thread: a new thread of a 32-bit game starts as
+  // an x86 one there, and FEX's own code would run as x86 on it. The work a
+  // writer would take (storing a block, pruning the memory LRU) runs on the
+  // thread that hands it over, one item at a time; a store prunes from inside,
+  // so the lock can be taken again by the thread that holds it.
+  static void QueueOrRun(WorkQueueThread* Writer, fextl::unique_ptr<WorkQueueThread::WorkItem> Item) {
+    if (Writer) {
+      Writer->QueueWork(std::move(Item));
+      return;
+    }
+    static std::recursive_mutex InlineWorkMutex;
+    std::scoped_lock Lock(InlineWorkMutex);
+    Item->Run();
+  }
